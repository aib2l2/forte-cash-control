{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ForteAI: создать .env",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/setup_env.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "ForteAI: тесты",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "tests", "cash_ml", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "ForteAI: проверка кода",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "check", "."],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
