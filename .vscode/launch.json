{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend — FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["cash_ml.api:app", "--host", "127.0.0.1", "--port", "8000", "--workers", "1"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Frontend — Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "cash_ml/app.py"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "ForteAI — всё приложение",
      "configurations": ["Backend — FastAPI", "Frontend — Streamlit"],
      "stopAll": true
    }
  ]
}
